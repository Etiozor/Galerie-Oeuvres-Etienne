# Configuration npm pour le projet Galerie POF
#
# legacy-peer-deps : certains packages (better-auth, drizzle-orm) ont des
# déclarations de peer dependencies strictes qui entrent en conflit dans npm v7+.
# Cette option reproduit le comportement de npm v6 qui accepte des peer deps incompatibles.
# Cela ne cause pas de problèmes en pratique pour ce projet.
legacy-peer-deps=true
