{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Avatar/**",
              "components/Badge/**",
              "components/Button/**",
              "components/Card/**",
              "components/Dialog/**",
              "components/EditToolbar/**",
              "components/EmptyState/**",
              "components/Field/**",
              "components/Nav/**",
              "components/ProgressBar/**",
              "components/StatTiles/**",
              "components/Tabs/**",
              "doc-page.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Merriweather Sans|Oswald|Barlow|Cormorant Garamond))/i]",
        "message": "Font not provided by the design system. Available: Merriweather Sans, Oswald, Barlow, Cormorant Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|tone|size|pending|title|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, label, tone, size, pending, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|critical|neutral|solid)$/]",
        "message": "<Avatar> tone must be one of 'primary' | 'success' | 'warning' | 'critical' | 'neutral' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|critical|neutral)$/]",
        "message": "<Badge> tone must be one of 'primary' | 'success' | 'warning' | 'critical' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|compact|full|children|onClick|disabled|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, compact, full, children, onClick, disabled, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|critical|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'critical' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|badge|meta|footer|children|onClick|padded|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, title, badge, meta, footer, children, onClick, padded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|critical|neutral)$/]",
        "message": "<Card> tone must be one of 'primary' | 'success' | 'warning' | 'critical' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|children|footer|onClose|width|open|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, eyebrow, children, footer, onClose, width, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditToolbarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|active|weight|italic|caret|title|key|ref|className|style|children)$/]",
        "message": "<EditToolbarItem> doesn't accept that prop. Declared props: id, label, active, weight, italic, caret, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|action|dashed|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, message, action, dashed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|onChange|hint|error|multiline|readOnly|id|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, onChange, hint, error, multiline, readOnly, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|leading|trailing|sticky|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: title, subtitle, leading, trailing, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|label|caption|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, height, label, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|critical|neutral)$/]",
        "message": "<ProgressBar> tone must be one of 'primary' | 'success' | 'warning' | 'critical' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|critical|neutral)$/]",
        "message": "<StatTile> tone must be one of 'primary' | 'success' | 'warning' | 'critical' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
