# .env.example
# Template de configuration pour la Galerie POF.
#
# INSTRUCTIONS :
# 1. Copier ce fichier en .env.local : cp .env.example .env.local
# 2. Remplir les valeurs (voir les commentaires de chaque variable)
# 3. Ne jamais commiter .env.local — ce fichier (.env.example) est le seul versionné
#
# Ce fichier ne contient aucune vraie clé secrète — seulement des placeholders.

# URL de connexion PostgreSQL
# Démarrer la base avec : docker compose up -d
# Format : postgresql://utilisateur:motdepasse@hôte:port/base_de_données
DATABASE_URL="postgresql://pof_user:pof_dev_password@localhost:5432/galerie_pof"

# Clé secrète Better Auth pour signer les sessions
# Générer avec : openssl rand -base64 32
# Ou en Node.js : require('crypto').randomBytes(32).toString('base64')
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Backend de stockage : "local" (dev) ou "r2" (production)
STORAGE_BACKEND="local"

# Dossier local d'upload (uniquement si STORAGE_BACKEND=local)
LOCAL_UPLOAD_DIR="./uploads"

# Clé API Resend pour les emails de notification (requis en Phase 4)
# Créer un compte sur https://resend.com et générer une clé
RESEND_API_KEY=""
