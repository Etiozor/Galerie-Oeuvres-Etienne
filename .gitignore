# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables d'environnement locales (contiennent des secrets)
# .env.example est versionné car il ne contient pas de vraies valeurs
.env.local
.env.*.local

# Dossier d'uploads local (images stockées en développement)
# Les images uploadées par l'artiste ne doivent pas être commitées
/uploads/**/*
!/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# Variables d'environnement locales
.env

# Fichiers locaux personnels (photos, notes, exports de design)
Images\ Upload/
Notes.md
design_galerie.bin
design_galerie_extracted/
design_upload_extracted/
